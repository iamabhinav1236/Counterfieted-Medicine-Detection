# Copy to .env and replace every placeholder with unique values.
TRUEDOSE_SECRET_KEY=replace-with-a-long-random-secret
TRUEDOSE_ADMIN_PASSWORD=replace-with-a-strong-unique-password
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
TRUEDOSE_COOKIE_SECURE=0
# Optional absolute database path (Docker Compose sets this automatically):
# TRUEDOSE_DB_PATH=/absolute/path/to/truedose.db
